{
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ここはどこ？しかも大きなクジラがいる！？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "驚き",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[sine]...かわいい... 塔へ... ..あなたの... 答えが... ある...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[sine]...戻って...きたのね..... \n...青い髪の... ..小さな女の子.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[sine]...何が.. 必要なの...？[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "悲しみ",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "どうしてまた失敗しちゃったの。",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[sine]...怖がらないで... 私が... \n..ずっと... ここに... ..助けてあげる.....[/sine]",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "わあ...ちっちゃなものがいっぱい！まるで灯の部屋みたい。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.ancient": "それは誰？僕と同じように忘れられた宝石を集めてるのかい？",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "また来たね？昔の友達と同じような宝石を一つ選んで持って帰りな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "ここには無数の宝石があるけど、君の言う品は見たことないな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "返事",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "灯もかわいい石をいっぱい集めてるの！\n今度持ってきて見せてあげる！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "はは。待ってるよ。でも「次」はだいぶ先になりそうだ。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ごきげんよう！ここはとても優雅ですわ！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "あら、ようやく私を理解してくれる小さな女の子が来たわ。優雅の力を授けましょう。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "かわいそうな小さな女の子、建築家にまた追い落とされたの？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.ancient": "そんなにうつむかないで。拭かせてちょうだい。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.next": "丁寧に断る",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.char": "大丈夫ですわ！頑張り続けますから！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2r.ancient": "本当に頑張り屋の小さな女の子ね。受け取って。新しい服を着た姿を見せてちょうだい。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ごきげんよう……！きれいですわね。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "かわいい小さな女の子！！会えて嬉しいよ！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "小さな話！！小さな話！！今回も聞きたい！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.char": "そんなに好きなら、もう一度カブトムシの話をするわ！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "何が欲しい？「ピアノ」の音！？それ何？！聴きたい聴きたい！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "演奏",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "ミレドレミファミレ～",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "いい！！いい！！ピアノ！！いい音！！",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "……ごきげんよう？",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[thinky_dots]かわいい小さな女の子……私の一部を持って行って、もっと眠らせて……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[thinky_dots]とても疲れているようだね……君も少し眠るといい……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[thinky_dots]私の血肉を持って行きなさい……君のかわいさへのご褒美だよ……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "答える",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……痛くないの？ペルさん、もらっていくわね……？",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[thinky_dots]受け取って……君みたいなかわいい小さな女の子の役に立てるなら……私も良い夢が見られる[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ごきげんよう！君はとても強そうだね！！！",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[b]はは！！本当にかわいい！！[/b]\n[b]この武器を持ってけ！！俺と同じくらい強くなれる！！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[b]少し疲れてるみたいだな！でも戦いがお前を熱くするぜ！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[b]小さな女の子！！俺と戦え！！成長を見せてみろ！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "全力で",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "うわあ、全然歯が立たない...\n[i][font_size=22]さきこは地面に座り込み、荒く息をしている。[/font_size][/i]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[b]弱い！！だが、そのかわいさも力の一つだ！！[/b]\n[b]この武器を受け取れ！！かわいい小さな女の子！！[/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ごきげんよう。ここはとても暖かいわ...",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "はは、じゃあもう一度君の心を[jitter][b]暖めて[/b][/jitter]あげよう。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "あらあら...君は何かを[jitter][b]抱え込み[/b][/jitter]すぎているようだね？燃やしてあげようか？",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "さきこ、私が入れた[jitter][b]紅茶[/b][/jitter]を飲んでみて。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "喜び",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……ありがとう、テスカタラ！懐かしいわ。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "本当にかわいい。それじゃあ、苦みが[jitter][b]消える[/b][/jitter]まで待とうか。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "ごきげんよう。失礼ですが、あなたは悪魔さんですか？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "はは、[sine]ヴァクー[/sine]と呼んでくれ、かわいい小さな女の子。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "本当はもっと高く売りたかったんだ。でも君が相手だと、[sine]「値引き」[/sine]が当たり前になってしまう。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "契約を結ぼう！[sine]いつか帰れる[/sine]ようにしてあげる——サインするかい？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "返事",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……今度は何を騙そうって言うの！",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "この退屈な場所で、[sine]かわいい小さな女の子[/sine]がいるのは本当に楽しい。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-attack": "Both",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0r.char": "ごきげんよう、元の世界に戻りたいの！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1r.ancient": "誰だ？全く見覚えがない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1r.next": "答える",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-2r.char": "どういう意味……？だめなの？",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-2r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-3r.ancient": "訳が分からない。この塔は奇妙なことばかりだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-3r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-4r.ancient": "何を言っているのか全く分からない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "良かった、また戻ってきたな。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-1r.char": "あんたを…倒すんだから！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-2r.ancient": "愚かな。俺を倒せば帰れるという奇妙な考えはどこから来たんだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.ancient": "なぜだ？その曖昧な声のせいか？俺はお前に何の恨みもない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.char": "私の友達が…待っているの！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2r.ancient": "頑固だな。",

  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "あっ！大きなクジラ！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "驚き",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[sine]...塔へ... 建築家を探せ...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "喋る大きなクジラ！ああ！！すごい！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "こんにちはこんにちは！大きなクジラなのにどうやって喋れるの？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "それにしても、こんなに高い塔があるなんて。すごく壮大！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.char": "君はここの守護者？それとも魔王の先鋒隊長？！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-6.ancient": "[sine]...君は...うるさい...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0.ancient": "[sine]...なぜ...戻ってきた..... \n...うるさい... 小さな女の子.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1.char": "うう、建築家は本当に理不尽だ...",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2.char": "まだ何も言ってないのに。",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-3.char": "彼がいきなり攻撃してきた！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-3.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-4.char": "私、怒らせることなんて何もしてないのに！！！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-4.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-5.char": "この建築家嫌い！！！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-5.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-6.ancient": "[sine].....おお...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "[sine]...かわいい.... ピンクの小さな女の子..\n 助け... ..いる...？[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "悲しみ",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "建築家なんて大っ嫌いだ....！",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "[sine]...怒らないで... 一緒に... \n....彼を... 倒そう.....[/sine]",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "わあ...ここにはキラキラしたものがいっぱい！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "はは。センスのいい女の子だね、一つ選んでみな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "戻ったね？今回はどれを選ぶんだい？",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.char": "あのキラキラしたのが欲しい！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "小さな女の子、だんだん口数が多くなってきたね！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "返事",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "うわあ！仲良くなったからつい喋りすぎちゃった。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "はは。大丈夫、君の騒がしさを聞くのも悪くない。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "うわあ！ここ！すごく大きい！！！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "あら、かわいい小さな女の子、もっと綺麗になりたい？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "なりたい！！！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "うわあ！この服もすごく綺麗！！！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "持って帰ったら絶対[pink]目立つ[/pink]よ！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.ancient": "本当に元気ね、気に入ったなら持って行きな。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "かわいい小さな女の子、建築家にうるさいって嫌われたのかい？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "あらあら、またそんなにひどい格好になって。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "道中の人たちは本当に礼儀を知らないんだから！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "まあまあ、彼らが優雅の道を知らないだけよ。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "わわわ！これは何！！！すごく綺麗！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "会えて嬉しいよ！！！ピンクの小さな女の子！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "君もここの先古の民なの？",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "ここもすごく綺麗すぎる！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "君もかわいい！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.ancient": "君もかわいい！！！好きだ！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "来たね！！！おしゃべりな小さな女の子！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.char": "来たよ！！！話を聞いてよ、今回は何に会ったか...",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "かわいい小さな女の子！！！これをあげる！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "わあ！！！これすごく綺麗！！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "気に入ってくれてよかった！！！",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "……こんにちは？",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[thinky_dots]……しーっ……欲しいものは自分で持って行って……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "[thinky_dots]とても元気そうだね……少し寝た方がいいかも……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "[thinky_dots]……礼儀正しいね……これを持って行きな……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "[thinky_dots]……うん……静かにする……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "[thinky_dots]……君はかわいい良い子だね……良い夢を見て……[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "わあ！！！すごく大きい！！！",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[b]はは！！俺は確かに強いんだ！！[/b]\n[b]さあ！！この武器をやろう！！俺みたいに強くなれる！！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "[b]とても元気だな！！！俺と戦ってみろ！！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "[b]はは！！力は小さいが！！心はとても強い！！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "本当に！！",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.char": "ありがとう！！！！",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-3.ancient": "[b]受け取れ！！！この武器で体も強くなれる！！！\nかわいい小さな女の子！！[/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "こんにちは～",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.char": "ああ！！！いい匂い！！！何の匂い？！",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.ancient": "はは、飲んでみるかい？この[jitter][b]温かい[/b][/jitter]美味しいスープを。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "あらあら...戻ったのかい？[jitter][b]温かい[/b][/jitter]スープを飲んでいかない？",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "ふふ...相変わらず[jitter][b]元気[/b][/jitter]だね。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "テスカタラありがとう！！この前飲んだやつがまた欲しい！！",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "はは、じゃあその間にもっとおしゃべりに付き合ってよ。\nもっと君の[jitter][b]話し声[/b][/jitter]を聞きたいんだ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "わあ！！まるで悪魔みたいな見た目！！",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[sine]ヴァクー[/sine]と呼んでくれ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "それで、君は悪魔なの？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "少しおとなしくしてくれたら、[sine]「値引き」[/sine]してあげるよ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "君と契約したいんだ、[sine]口数を減らす[/sine]——どうだい？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "ああ！！この悪魔め！！",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "はは、ちょっとからかっただけさ。\nこの荒涼とした場所で、誰かと[sine]話ができる[/sine]だけでもいいものだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-attack": "Both",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0r.char": "ふう！やっと塔の頂上だ！そこのおじさんこんにちは！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1r.ancient": "うるさい。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "なぜまた来た。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.char": "前回、話が終わってなかった！！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2r.ancient": "少し静かにできないのか、お前はあの四角いパンと同じくらいうるさい。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "一体どんな理由で、お前はしつこく俺を煩わせに来るんだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "元の世界に戻りたいんだ！！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "できないと言っただろう。",

  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "クジラ？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "好奇心",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.ancient": "[sine]....子猫？...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.char": "どうして喋れるの？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.ancient": "[sine]....建築家を.. 探しに...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "[sine]...落ち込まないで..... \n...キャンディーをあげる...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.char": "本当？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.ancient": "[sine]...食べたいの..... \n...[green]抹茶パフェ[/green]？...それは何....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.char": "食べたい。",

  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "面白い...宝物の場所。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.ancient": "みんな宝物だよ、[gold]異[/gold][blue]色[/blue]瞳の小さな女の子！気に入ったかい？一つ選びな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.char": "紫の...いい人...？",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.ancient": "しかも紫の[purple]*コレクター*[/purple]だ！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "また来たね？今回はどれが欲しい？",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.char": "戻るのを手伝ってくれるもの。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-2r.ancient": "かわいい小さな女の子、持って行きな、ちゃんと使うんだよ！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.ancient": "また会ったね？[gold]異[/gold][blue]色[/blue]瞳の小さな女の子。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.next": "返事",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.char": "（目を細めて首を振った-.-）",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.ancient": "ここには宝物がたくさんあるんだ、よく見てごらん、欲しいものが見つかるよ！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "巨人？......",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.char": "巨大な魚......？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.ancient": "あら、かわいい小さな女の子、これらの優雅な祝福を授けましょう。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.ancient": "これらを身につければ、一番美しい女の子になれるわ。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "かわいそうな小さな女の子、建築家にまた追い落とされたの？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.ancient": "そんなにうつむかないで。拭かせてちょうだい。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.ancient": "君みたいなかわいい小さな女の子はちゃんと世話をされるべきよ。祝福をあげるわ。召使いたち！お茶を入れて。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2r.char": "ほしい......",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-3r.char": "[fade_in][color=#77DD77]抹茶パフェ。[/color][/fade_in]",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "……大きな虫。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.ancient": "子猫子猫！！どこから来たの！？どうして二色の目をしてるの！？会えて嬉しいよ！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "小さな話！！小さな話！！今回も聞きたい！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.char": "（[green]*スペース*[/green]のギターピックを取り出す）",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-2r.char": "ギター、話がある。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-2r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-3r.ancient": "ギター？！面白い！！プレゼントをあげる！聴かせて！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-3r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-4r.char": "[sine]*物語のあるギターの音が鳴る*[/sine]",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.ancient": "子猫！！ギター！！ギターを背負った小さな子猫！！プレゼントを持ってきたよ！！もっと聴きたい！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.char": "[jitter]*激しいギターの音が鳴る*[/jitter]",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2r.ancient": "いい！！いい！！ギター！！いい音！！",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "……眠い。",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.ancient": "[thinky_dots]……かわいい小さな女の子……よく眠らないと新しくなれないよ……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.ancient": "[thinky_dots]こっちにおいで......私の一部を持って行きな……安心して……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "[thinky_dots]とても疲れているようだね……少し眠りにおいで……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.ancient": "[thinky_dots]……静かな小さな子……私の一部を持って行きな……君が安心できるならそれでいい……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.char": "……ありがとう。",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.ancient": "[thinky_dots]……前の[color=#77BBDD]ピンクの女の子[/color]よりずっと静かだね......良い夢を見て……[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.ancient": "[b]白いの！！力は小さいが！！目つきは悪くない！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.char": "……うん。",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.ancient": "[b]受け取れ！！もっと強くなれ！！白い小さな女の子！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "[b]弱すぎるぞ、小さいの！！だがこの武器がお前を強くする！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.char": "キメラ。",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.ancient": "[b]白いの！！背負ってるのは武器か！！俺と戦え！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.char": "[jitter]*激しいギターの音が鳴る*[/jitter]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-3.ancient": "[b]爽快だ！！だが！武器じゃない！！これを持ってけ！！[/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0r.char": "お腹すいた。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0r.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1r.ancient": "はは、おいで、静かな小さな子。この[jitter][b]温かい[/b][/jitter]スープを飲んでごらん。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1r.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2r.char": "ほしい......",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2r.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3r.char": "[fade_in][color=#77DD77]抹茶パフェ。[/color][/fade_in]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "戻ったんだね？静かな小さな子。お腹が空いてちゃ先に進めないよ。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.ancient": "[jitter][b]温かい[/b][/jitter]スープを飲んでいきな。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.ancient": "ふふ...相変わらず[jitter][b]静か[/b][/jitter]だね。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.char": "前回の、おいしい。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.ancient": "はは、じゃあもう少しだけ付き合っておくれ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "黒い......",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.char": "（大きな角を見つめる）",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.char": "......コレクター？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.char": "（目を細めて首を振った-.-）",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-4.ancient": "[sine]ヴァクー——聖なる悪魔[/sine]、コレクターと呼んでもいいよ、へへ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-4.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-5.ancient": "[sine]なぜなら君が欲しいものをあげられるから。[/sine]",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-5.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-6.char": "ヴァクー。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-6.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-7.char": "[fade_in][color=#77BBDD]私の[/color][color=#FF8899]居場所[/color]...[color=#77DD77]帰りたい。[/color][/fade_in]",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "居場所に帰りたいという願いが君を導く、だから私に会ったんだ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.ancient": "小さな[sine]代償[/sine]を払うだけで、居場所にもっと近づけるよ。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.ancient": "また会ったね、まだ帰ってないの？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.ancient": "さあ、もう一つ[sine]小さな取引[/sine]を",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.char": "（首を振った-.-）",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-3.char": "役に立たない、[color=#77DD77]抹茶パフェをちょうだい。[/color][/fade_in]",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-3.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-4.ancient": "......",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-4.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-5.char": "......",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-5.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-6.ancient": "......",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-6.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-7.ancient": "......契約書にある[color=#7777AA]リッキー[/color]って誰だ？",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-attack": "Both",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0r.char": "帰る。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1r.ancient": "……誰？",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "またお前か。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.char": "帰る。[sine]ライブをやる。[/sine]",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-2r.ancient": "俺にはできない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.ancient": "なぜまだ来る。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.char": "帰りたい。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-2r.ancient": "頑固だな。",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.pages.INITIAL.description": "ごきげんよう！私と一緒にバンドを組んでくれませんか？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.title": "「豊川祥子？」",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.epithet": "夢のような幻影",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.ANY.0-0r.ancient": "ごきげんよう！私と一緒にバンドを組んでくれませんか？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.firstVisitEver.0-0.ancient": "ごきげんよう！私と一緒にバンドを組んでくれませんか？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.ancient": "ごきげんよう！こんにちは！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "こ、これは何ですの？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "あら？具合が悪そうに見えるわ",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.char": "（視界がぼやける）",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-2.ancient": "うわあ！泣かないで！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "ごきげんよう！また会えたわね！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.char": "ごきげんよう（抱きしめる）",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-1r.ancient": "お疲れ様、今回もしっかり助けるわ！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.ancient": "ごきげんよう！私と一緒にバンドを組んでくれませんか？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.ancient": "ごきげんよう！私と一緒にバンドを組んでくれませんか？",

  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.ancient": "ごきげんよう！こんにちは！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "こ、これは何ですの？",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "あら？具合が悪そうに見えるわ",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.char": "（視界がぼやける）",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-2.ancient": "うわあ！泣かないで！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "ごきげんよう！また会えたわね！",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.next": "続ける",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.char": "ごきげんよう（抱きしめる）",
  "CUTE_SAKIKO_MOD_EVENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-1r.ancient": "お疲れ様、今回もしっかり助けるわ！",

  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ここはどこ？しかも大きなクジラがいる！？",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "驚き",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "[sine]...かわいい... 塔へ... ..あなたの... 答えが... ある...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "[sine]...戻って...きたのね..... \n...青い髪の... ..小さな女の子.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "[sine]...何が.. 必要なの...？[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "悲しみ",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "どうしてまた失敗しちゃったの。",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "[sine]...怖がらないで... 私が... \n..ずっと... ここに... ..助けてあげる.....[/sine]",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "わあ...ちっちゃなものがいっぱい！まるで灯の部屋みたい。",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.ancient": "それは誰？僕と同じように忘れられた宝石を集めてるのかい？",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "また来たね？昔の友達と同じような宝石を一つ選んで持って帰りな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "ここには無数の宝石があるけど、君の言う品は見たことないな！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "返事",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "灯もかわいい石をいっぱい集めてるの！\n今度持ってきて見せてあげる！",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "はは。待ってるよ。でも「次」はだいぶ先になりそうだ。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ごきげんよう！ここはとても優雅ですわ！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "あら、ようやく私を理解してくれる小さな女の子が来たわ。優雅の力を授けましょう。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "かわいそうな小さな女の子、建築家にまた追い落とされたの？",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0r.ancient": "そんなにうつむかないで。拭かせてちょうだい。",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0r.next": "丁寧に断る",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1r.char": "大丈夫ですわ！頑張り続けますから！",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1r.next": "続ける",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2r.ancient": "本当に頑張り屋の小さな女の子ね。受け取って。新しい服を着た姿を見せてちょうだい。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ごきげんよう……！きれいですわね。",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "かわいい小さな女の子！！会えて嬉しいよ！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "小さな話！！小さな話！！今回も聞きたい！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.char": "そんなに好きなら、もう一度カブトムシの話をするわ！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "何が欲しい？「ピアノ」の音！？それ何？！聴きたい聴きたい！！",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "演奏",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "ミレドレミファミレ～",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "いい！！いい！！ピアノ！！いい音！！",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "……ごきげんよう？",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "[thinky_dots]かわいい小さな女の子……私の一部を持って行って、もっと眠らせて……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "[thinky_dots]とても疲れているようだね……君も少し眠るといい……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "[thinky_dots]私の血肉を持って行きなさい……君のかわいさへのご褒美だよ……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "答える",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "……痛くないの？ペルさん、もらっていくわね……？",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "[thinky_dots]受け取って……君みたいなかわいい小さな女の子の役に立てるなら……私も良い夢が見られる[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ごきげんよう！君はとても強そうだね！！！",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "[b]はは！！本当にかわいい！！[/b]\n[b]この武器を持ってけ！！俺と同じくらい強くなれる！！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "[b]少し疲れてるみたいだな！でも戦いがお前を熱くするぜ！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "[b]小さな女の子！！俺と戦え！！成長を見せてみろ！！[/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "全力で",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "うわあ、全然歯が立たないよ...\n[i][font_size=22]祥子は地面に座り込み、荒く息をしている。[/font_size][/i]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "[b]弱い！！だが、そのかわいさも力の一つだ！！[/b]\n[b]この武器を受け取れ！！かわいい小さな女の子！！[/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ごきげんよう。ここはとても暖かいわ...",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "はは、じゃあもう一度君の心を[jitter][b]暖めて[/b][/jitter]あげよう。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "あらあら...君は何かを[jitter][b]抱え込み[/b][/jitter]すぎているようだね？燃やしてあげようか？",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "祥子、私が入れた[jitter][b]紅茶[/b][/jitter]を飲んでみて。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "喜び",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "……ありがとう、テスカタラ！懐かしいわ。",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "本当にかわいい。それじゃあ、苦みが[jitter][b]消える[/b][/jitter]まで待とうか。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.char": "ごきげんよう。失礼ですが、あなたは悪魔さんですか？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1.ancient": "はは、[sine]ヴァクー[/sine]と呼んでくれ、かわいい小さな女の子。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "本当はもっと高く売りたかったんだ。でも君が相手だと、[sine]「値引き」[/sine]が当たり前になってしまう。",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.ancient": "契約を結ぼう！[sine]いつか帰れる[/sine]ようにしてあげる——サインするかい？",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0.next": "返事",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.char": "……今度は何を騙そうって言うの！",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1.next": "続ける",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2.ancient": "この退屈な場所で、[sine]かわいい小さな女の子[/sine]がいるのは本当に楽しい。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-attack": "Both",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0r.char": "ごきげんよう、元の世界に戻りたいの！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1r.ancient": "誰だ？全く見覚えがない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-1r.next": "答える",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-2r.char": "どういう意味……？だめなの？",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-2r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-3r.ancient": "訳が分からない。この塔は奇妙なことばかりだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-3r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.0-4r.ancient": "何を言っているのか全く分からない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.ancient": "良かった、また戻ってきたな。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-1r.char": "あんたを…倒すんだから！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.1-2r.ancient": "愚かな。俺を倒せば帰れるという奇妙な考えはどこから来たんだ。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0r.ancient": "なぜだ？その曖昧な声のせいか？俺はお前に何の恨みもない。",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-0r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1r.char": "私の友達が…待っているの！",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-1r.next": "続ける",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_OB.2-2r.ancient": "頑固だな。"
}
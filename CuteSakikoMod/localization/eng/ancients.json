{
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Where is this? And why is there a big whale!?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Surprised",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[sine]...cute... go to the tower... ..there is your... answer.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[sine]...you... came back..... \n...blue-haired... ..little girl.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[sine]...what.. do you... ..need...?[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Sad",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "Why did I fail again?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[sine]...don't be afraid... I will... \n..always... be... here... ..help you.....[/sine]",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Wow... so many little things! Just like Tomori-chan's room.",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.next": "Continue",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.ancient": "Who is that? Does she also collect many forgotten gems like me?",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "You're back? Pick a gem just like your old friend's and go back!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "I have countless gems here, but I've never seen the one you mentioned!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Reply",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "Tomori-chan also collects lots of cute stones!\nI'll bring them for you to see someday!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "Haha. I'll be waiting, though \"next time\" might be a long wait.",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Good day! This place is so elegant!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "Oh my, finally a little girl who understands me. Let me bestow upon you the power of elegance.",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "Poor little girl, did the Architect drive you down again?",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.ancient": "Don't be so downcast. Let me wipe it off for you.",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.next": "Politely decline",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.char": "It's okay! I'll keep trying!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2r.ancient": "What a hardworking little girl. Take this. Let me see how you look in new clothes.",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Good day……! You're so beautiful.",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "Cute little girl!! Nice to meet you!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "Little story!! Little story!! I want to hear it again this time!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.char": "You like it so much, then I'll tell the story of the rhinoceros beetle again!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "What do you want? The sound of a \"piano\"!? What's that?! I want to hear it, I want to hear it!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Play",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "mi re do re mi fa mi re~",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "Good!! Good!! Piano!! Sounds nice!!",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "……Good day?",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[thinky_dots]Cute little girl... take a part of me, and let me keep sleeping...[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[thinky_dots]You look very tired... you should sleep a while too...[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[thinky_dots]Take my flesh and blood... as a reward for your cuteness...[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Answer",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……Doesn't it hurt? Mr. Pael, I'm taking it...?",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[thinky_dots]Take it... being able to help such a cute little girl like you... I can have a good dream too[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Good day! You look so powerful!!!",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "[b]Haha!! So cute!![/b]\n[b]Take this weapon!! You can become as strong as me!!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "[b]You look a bit tired! But battle can make your blood boil!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "[b]Little girl!! Fight me!! Show me your growth!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "With full strength",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "Uwaah, I can't even scratch him...\n[i][font_size=22]Sakiko sits on the ground, panting heavily.[/font_size][/i]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "[b]Weak!! But your cuteness is also a strength!![/b]\n[b]Take this weapon!! Cute little girl!![/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Good day. It's so warm here...",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "Haha, then let me [jitter][b]warm[/b][/jitter] your heart a bit more.",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "Oh my... you seem to be [jitter][b]carrying[/b][/jitter] too many things? Shall I burn them away for you?",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "Sakiko, come taste the [jitter][b]black tea[/b][/jitter] I made for you.",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Joy",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……Thank you, Tezcatara! This is so nostalgic.",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "So cute. Now let's wait together until the bitterness [jitter][b]fades away[/b][/jitter].",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Good day. Excuse me, are you Mr. Demon?",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1.ancient": "Haha, you can call me [sine]Vakuu[/sine], cute little girl.",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "Originally I wanted to sell it for more. But facing you, [sine]\"discount\"[/sine] seems to become the norm.",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.ancient": "Let's make a contract! Allowing you to [sine]go back someday[/sine]——will you sign?",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0.next": "Reply",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.char": "……What are you trying to trick me into this time!",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2.ancient": "In this boring place, having a [sine]cute little girl[/sine] really makes me happy.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-attack": "Attack",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0r.char": "Good day, I want to go back to my original world!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1r.ancient": "Who are you? I have no impression of you at all.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-1r.next": "Answer",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-2r.char": "What do you mean...? Can't I?",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-2r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-3r.ancient": "Ridiculous. More and more strange things are happening in this tower.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-3r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-4r.ancient": "I don't understand what you're talking about at all.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.ancient": "Good, you're back again.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-1r.char": "I'm going to... defeat you!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.1-2r.ancient": "Foolish. Where did you get that strange idea that defeating me will let you go back?",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.ancient": "Why? Just because of that vague voice? I have no grudge against you.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.char": "My friends... are still waiting for me!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r-attack": "Attack",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.2-2r.ancient": "So stubborn.",

  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Ah! Such a big whale!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Surprised",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[sine]...go to the tower... find the Architect...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "A talking big whale! Ah!! So amazing!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "Hello hello! How can a big whale like you talk?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "And there's such a tall tower here. So spectacular!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.char": "Are you the guardian here? Or the demon lord's vanguard captain?!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-6.ancient": "[sine]...you... are so noisy...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0.ancient": "[sine]...why did you... come back..... \n...noisy... little girl.....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1.char": "Uuu, the Architect is so unreasonable...",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2.char": "I haven't even said anything yet.",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-3.char": "He suddenly started attacking me!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-3.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-4.char": "I didn't even make him angry!!!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-4.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-5.char": "I hate this Architect!!!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-5.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-6.ancient": "[sine].....oh...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "[sine]...cute.... pink little girl..\n need... ..help...?[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "Sad",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "I hate the Architect so much....!",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "[sine]...don't be angry... let's... \n....defeat... him... together.....[/sine]",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Wow... there are so many shiny things!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "Haha. You're a girl with taste. Come and pick one!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "You're back? Which one will you pick this time?",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "Continue",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.char": "I want that shiny thing!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "Little girl, I find you're getting more and more talkative!",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Reply",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "Uwaa! We've gotten closer, so I couldn't help but talk more.",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "DARV.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "Haha. It's fine. Listening to your chatter actually doesn't feel bad.",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Uwaa! This place! So big!!!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "Oh my, such a cute little girl. Do you want to become more beautiful?",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "I do!!!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "Uwaa! This dress is so beautiful too!!!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "If I bring it back, I'll definitely [pink]stand out[/pink]!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.ancient": "So lively. If you like it, take it with you.",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "Cute little girl, the Architect actually found you noisy?",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "Oh dear, how did you get so disheveled again?",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "Those people on the way really have no manners at all!",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "Continue",
  "NONUPEIPE.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "There, there, it's them who don't understand the way of elegance.",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Wowowow! What is this!!! So pretty!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "So happy to meet you!!! Pink little girl!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "Are you also an Ancient here?",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.char": "This place is too beautiful!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-3.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.char": "You're so cute too!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-4.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-5.ancient": "You're so cute too!!! I like you!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "You're here!!! Talkative little girl!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.char": "I'm here!!! Let me tell you, what I encountered this time...",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "Cute little girl!!! Here, this for you!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "Wah!!! This is so pretty!!!",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "OROBAS.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "I'm glad you like it!!!",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "……Hello?",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[thinky_dots]……Shh…… take whatever you want yourself……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "[thinky_dots]You look very lively…… maybe it's better to sleep a while……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "[thinky_dots]……You're very polite…… take these……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Continue",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "[thinky_dots]……Okay…… I'll be quiet……[/thinky_dots]",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "PAEL.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "[thinky_dots]……You're a cute good girl…… I hope you have a good dream too……[/thinky_dots]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Wah!!! So big!!!",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[b]Haha!! I am indeed very powerful!![/b]\n[b]Here!! Take this weapon!! You can become as strong as me!!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "[b]You look so lively!!! Come and have a battle with me!!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "[b]Haha!! Although your strength is small!! Your heart is very strong!!![/b]",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "Really!!",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.char": "Thank you!!!!",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.next": "Continue",
  "TANX.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-3.ancient": "[b]Catch!!! This weapon can make your body strong too!!!\nCute little girl!![/b]",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Hello~",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.char": "Ah!!! It smells so good!!! What's that smell?!",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.ancient": "Haha, want to try drinking this, [jitter][b]warm[/b][/jitter] delicious soup.",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "Oh my... you're back? Come have some [jitter][b]warming[/b][/jitter] delicious soup?",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "Hehe... you're still so [jitter][b]lively[/b][/jitter].",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "Thank you, Tezcatara!! I still want the one I drank last time!!",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "TEZCATARA.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "Haha, then chat with me more while you're here,\nI want to hear you [jitter][b]talk[/b][/jitter] more.",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.char": "Wah!! You look just like a demon!!",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.ancient": "[sine]Vakuu[/sine], please call me that.",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-2.char": "So are you a demon?",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "If you can quiet down for a bit, I'll give you a [sine]\"discount\"[/sine].",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.ancient": "I want to make a contract with you, [sine]less talking[/sine]——how about it?",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.char": "Ah!! You bad demon!!",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1.next": "Continue",
  "VAKUU.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2.ancient": "Haha, just teasing you.\nIn this desolate place, having someone to [sine]talk to[/sine] is pretty nice.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-attack": "Attack",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0r.char": "Phew! Finally reached the top of the tower! Hello over there, sir!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.0-1r.ancient": "So noisy.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.ancient": "Why have you come again.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.char": "Last time I didn't even finish talking!!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.1-2r.ancient": "Can you be quiet for a while, you're as noisy as that square bread.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.ancient": "What reason on earth makes you keep coming to annoy me.",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-0r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.char": "I want to go back to my previous world!!",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r-attack": "Attack",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_ANON.2-2r.ancient": "I told you I can't do that.",

  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.char": "Whale?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-0.next": "Curious",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.ancient": "[sine]....kitty?...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-1.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.char": "Why can you talk?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-2.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.0-3.ancient": "[sine]....go find.. the Architect...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.ancient": "[sine]...don't be discouraged..... \n...I'll give you.. candy...[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-0r.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.1-1r.char": "Really?",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.ancient": "[sine]...you want to eat..... \n...[green]matcha parfait[/green]?... what's that....[/sine]",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-0r.next": "Continue",
  "NEOW.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_RANA.2-1r.char": "I want to eat.",


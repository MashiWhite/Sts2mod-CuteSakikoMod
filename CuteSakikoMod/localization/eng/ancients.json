  "CUTE_SAKIKO_MOD_ANCIENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.next": "Continue",
  "CUTE_SAKIKO_MOD_ANCIENT_ANOTHER_SELF.talk.CUTE_SAKIKO_MOD_CHARACTER_CUTE_SAKI.0-0.char": "Th-this... what is this?",

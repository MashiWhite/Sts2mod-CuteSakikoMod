<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <!-- ★ Mod 版本号自动从 CuteSakikoMod.json 读取 -->
    <PropertyGroup>
        <_ManifestPath>$(MSBuildProjectDirectory)\CuteSakikoMod.json</_ManifestPath>
        <_ManifestContent Condition="Exists('$(_ManifestPath)')">$([System.IO.File]::ReadAllText('$(_ManifestPath)'))</_ManifestContent>
        <_ManifestVersion Condition="'$(_ManifestContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_ManifestContent), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_ManifestVersion>
        <_ManifestGameVersion Condition="'$(_ManifestContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_ManifestContent), '"min_game_version"\s*:\s*"([^"]+)"').Groups[1].Value)</_ManifestGameVersion>
        <Version Condition="'$(_ManifestVersion)' != ''">$(_ManifestVersion)</Version>
        <InformationalVersion Condition="'$(_ManifestVersion)' != ''">$(_ManifestVersion)</InformationalVersion>
        <AssemblyVersion Condition="'$(_ManifestVersion)' != ''">$(_ManifestVersion).0</AssemblyVersion>
    </PropertyGroup>

    <!-- 版本号诊断日志 -->
    <Target Name="LogModVersion" BeforeTargets="CoreCompile">
        <Message Text="[CuteSakikoMod] Version from manifest: $(_ManifestVersion) (Version=$(Version), InformationalVersion=$(InformationalVersion)), GameTarget: $(_ManifestGameVersion)" Importance="high"/>
    </Target>

    <!-- OS Detection & Paths -->
    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <SteamLibraryPath>E:/SteamLibrary/steamapps</SteamLibraryPath>
        <GodotPath>E:/SLJT2/anti/GODOT/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <!-- 引用 -->
    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="CuteSakikoMod/localization/**/*.json"/>
        <PackageReference Include="STS2.RitsuLib" Version="0.6.8" />
    </ItemGroup>

    <!-- 资源排除与包含 -->
    <ItemGroup>
        <Compile Remove="CuteSakikoMod/**"/>
        <Compile Remove="materials/**"/>
        <Compile Remove="shaders/**"/>
        <Compile Remove="images/**"/>
        <EmbeddedResource Remove="CuteSakikoMod/**"/>
        <EmbeddedResource Remove="materials/**"/>
        <EmbeddedResource Remove="shaders/**"/>
        <EmbeddedResource Remove="images/**"/>
        <Compile Remove="CuteSakikoModCode\Cards\Rana\Uncommon\ManyCats.cs"/>
        <Compile Remove="CuteSakikoModCode\Cards\Rana\Common\AllAreCats.cs"/>
        <Compile Remove="CuteSakikoModCode\Cards\Rana\Common\WatchCats.cs"/>
        <Compile Remove="CuteSakikoModCode\Cards\Rana\Common\CatPet.cs"/>
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore"/>
        <None Include=".godotignore"/>
        <None Include="CuteSakikoMod.json"/>
        <None Include="project.godot"/>
        <None Include="CuteSakikoMod/**"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="CuteSakikoModCode\Cards\Mod\Token\"/>
        <Folder Include="CuteSakikoModCode\Cards\Rana\Ancient\"/>
        <Folder Include="CuteSakikoModCode\Cards\Rana\Token\"/>
        <Folder Include="CuteSakikoModCode\Encounters\Normal\"/>
        <Folder Include="CuteSakikoModCode\Monsters\Normal\"/>
        <Folder Include="CuteSakikoModCode\Potions\Shared\Uncommon\"/>
        <Folder Include="CuteSakikoModCode\Relics\Anon\Uncommon\"/>
        <Folder Include="CuteSakikoModCode\Relics\Other\Common\"/>
        <Folder Include="CuteSakikoModCode\Relics\Other\Rare\"/>
        <Folder Include="CuteSakikoModCode\Relics\Other\Uncommon\"/>
        <Folder Include="CuteSakikoModCode\Relics\Saki\Ancient\"/>
        <Folder Include="CuteSakikoModCode\Relics\Saki\Event\"/>
        <Folder Include="CuteSakikoMod\images\ui\run_history\"/>
        <Folder Include="CuteSakikoMod\scenes\others\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="audio\look_cchord.mp3"/>
    </ItemGroup>

    <!-- 构建后复制你自己的 Mod -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build">
        <Message Text="Copying mod files to game mods folder." Importance="high"/>
        <MakeDir Directories="$(ModsPath)$(MSBuildProjectName)" Condition="!Exists('$(ModsPath)$(MSBuildProjectName)')"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)"/>
        <Copy SourceFiles="CuteSakikoMod.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)"/>
    </Target>

    <!-- 把 audio 目录下的文件原样复制到模组文件夹 -->
    <Target Name="CopyAudioToModsFolder" AfterTargets="CopyToModsFolderOnBuild">
        <Message Text="Copying audio files to game mods folder." Importance="high"/>
        <ItemGroup>
            <AudioFilesToCopy Include="@(None)"
                              Condition="$([System.String]::new('%(Identity)').Contains('audio'))"/>
            <MappedAudioFiles Include="@(AudioFilesToCopy)">
                <DestPath>$(ModsPath)$(MSBuildProjectName)\%(Identity)</DestPath>
            </MappedAudioFiles>
        </ItemGroup>
        <Copy SourceFiles="@(MappedAudioFiles)"
              DestinationFiles="@(MappedAudioFiles->'%(DestPath)')"
              SkipUnchangedFiles="true"/>
    </Target>

    <Target Name="GodotPublishOnBuild" AfterTargets="Build"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder (from Build)" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <!-- 路径检查 -->
    <Target Name="CheckDependencyPaths">
        <Error Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')"/>
        <Error Text=" Godot not found at path '$(GodotPath)'"
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"/>
    </Target>

    <ItemGroup>
        <None Include="audio\**\*">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <GodotResource>false</GodotResource>
        </None>
    </ItemGroup>
</Project>